<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Mecanica Hermes Shared SDK (GitHub Packages: fiap-challenge-13soat) -->
    <PackageVersion Include="Mecanica.Hermes.Shared.Core" Version="1.0.0" />
    <PackageVersion Include="Mecanica.Hermes.Shared.Application" Version="1.0.0" />
    <PackageVersion Include="Mecanica.Hermes.Shared.AspNetCore" Version="1.0.0" />
    <PackageVersion Include="Mecanica.Hermes.Shared.Observability" Version="1.0.0" />
    <PackageVersion Include="Mecanica.Hermes.Contracts" Version="1.0.0" />
    <!-- Logging -->
    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Enrichers.ClientInfo" Version="2.9.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <!-- OpenTelemetry -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Resources.Container" Version="1.15.0-beta.1" />
    <!-- Serilog OTel sink (log forwarding to New Relic) -->
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <!-- Serilog trace correlation enricher -->
    <PackageVersion Include="Serilog.Enrichers.Span" Version="3.1.0" />
    <!-- Mass Transit -->
    <PackageVersion Include="MassTransit" Version="8.5.9" />
    <PackageVersion Include="MassTransit.Abstractions" Version="8.5.9" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.9" />
    <PackageVersion Include="MassTransit.AmazonSQS" Version="8.5.9" />
    <PackageVersion Include="MassTransit.MongoDb" Version="8.5.9" />
    <PackageVersion Include="MassTransit.TestFramework" Version="8.5.9" />
    <PackageVersion Include="Autofac" Version="9.1.0" />
    <PackageVersion Include="Autofac.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.0" />
    <PackageVersion Include="FluentAssertions" Version="8.9.0" />
    <PackageVersion Include="MediatR" Version="14.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.14.4" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- MongoDB driver -->
    <PackageVersion Include="MongoDB.Driver" Version="3.7.1" />
    <PackageVersion Include="AspNetCore.HealthChecks.MongoDb" Version="9.0.0" />
    <!-- Mercado Pago SDK -->
    <PackageVersion Include="mercadopago-sdk" Version="2.8.0" />
    <!-- Test data faking & utilities -->
    <PackageVersion Include="Bogus" Version="35.6.3" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.11.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.11.0" />
    <PackageVersion Include="WireMock.Net" Version="1.8.0" />
    <!-- Architecture tests -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Validation -->
    <PackageVersion Include="FluentValidation" Version="11.12.0" />
    <!-- Resilience -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="9.6.0" />
    <PackageVersion Include="Polly.Core" Version="8.6.2" />
  </ItemGroup>
</Project>
