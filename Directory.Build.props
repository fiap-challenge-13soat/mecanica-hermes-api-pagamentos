<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>false</InvariantGlobalization>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>Mecânica Hermes Team</Authors>
        <Company>Mecânica Hermes</Company>
        <Product>Mecânica Hermes</Product>
        <Copyright>Copyright © 2026 Mecânica Hermes</Copyright>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DebugType>full</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
    </PropertyGroup>

    <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- xUnit AAA-style naming (Method_Scenario_Expected) é intencional em testes.
             CA1724 (test class shares name with namespace) é esperado em ArchitectureTests/IntegrationTests.
             CA1861 (static readonly arrays) é irrelevante em [Fact] que executa 1x por suíte.
             CA1873 dispara em matchers Moq (It.IsAny<>), não em invocações reais de logger.
             CA1711 (sufixo Collection) é convenção do xUnit para CollectionDefinition. -->
        <NoWarn>$(NoWarn);CA1707;CA1724;CA1861;CA1873;CA1711</NoWarn>
    </PropertyGroup>

    <!-- Roslyn code analyzers for all projects -->
    <PropertyGroup>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisMode>Recommended</AnalysisMode>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    </PropertyGroup>
</Project>
