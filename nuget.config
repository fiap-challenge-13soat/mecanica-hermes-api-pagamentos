<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github-mechermes" value="https://nuget.pkg.github.com/fiap-challenge-13soat/index.json" />
  </packageSources>

  <packageSourceCredentials>
    <github-mechermes>
      <add key="Username" value="%GITHUB_USERNAME%" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github-mechermes>
  </packageSourceCredentials>

  <!-- Mapeia explicitamente cada source para evitar NU1507. Apenas pacotes
       Mecanica.Hermes.Shared.* + Contracts saem do GitHub Packages. -->
  <packageSourceMapping>
    <packageSource key="github-mechermes">
      <package pattern="Mecanica.Hermes.Shared.*" />
      <package pattern="Mecanica.Hermes.Contracts" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
